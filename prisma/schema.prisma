// Authoritative data model for the store (spec.md §5).
// Generated client is ESM and lives in src/generated/prisma (gitignored).
// The datasource URL is supplied by prisma.config.ts, not this file (Prisma 7).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum TokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

enum Gender {
  MEN
  WOMEN
  UNISEX
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  EXPIRED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentProviderKind {
  EASYPAISA
  STRIPE
  FAKE
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

enum NotificationType {
  WELCOME
  EMAIL_VERIFICATION
  PASSWORD_RESET
  ORDER_CONFIRMATION
  ORDER_SHIPPED
  ORDER_DELIVERED
  ORDER_REFUNDED
}

// ---------------------------------------------------------------------------
// Identity (F1)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique // always stored lowercased
  name          String?
  passwordHash  String
  role          Role      @default(CUSTOMER)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions           Session[]
  verificationTokens VerificationToken[]
  addresses          Address[]
  orders             Order[]
  reviews            Review[]
  wishlist           WishlistItem[]
  notifications      Notification[]
  cart               Cart?

  @@index([role])
}

/// One row per issued refresh token. familyId groups every token descended from
/// a single login; replacedById marks a token as already rotated. A presented
/// token that is revoked or already replaced is a replay, and the whole family
/// is revoked (SEC-21).
model Session {
  id               String    @id @default(cuid())
  userId           String
  familyId         String
  refreshTokenHash String    @unique // sha256 of the raw token, never the token
  userAgent        String?
  ip               String?
  expiresAt        DateTime
  revokedAt        DateTime?
  replacedById     String?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

/// Email-verification and password-reset tokens: hashed, typed, single-use via
/// usedAt, and expiring (SEC-10).
model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  type      TokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Catalog (F2)
// ---------------------------------------------------------------------------

/// Two-level tree: a category has at most one parent, enforced in application
/// code since Prisma cannot express depth.
model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  image       String?
  position    Int      @default(0)
  isActive    Boolean  @default(true)
  parentId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
}

model Product {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  description    String
  brand          String?
  gender         Gender   @default(UNISEX)
  basePrice      Decimal  @db.Decimal(12, 2)
  compareAtPrice Decimal? @db.Decimal(12, 2)
  images         String[]
  attributes     Json     @default("{}")
  /// Cached aggregates, recomputed transactionally on review moderation (F6).
  ratingAvg      Decimal  @default(0) @db.Decimal(3, 2)
  ratingCount    Int      @default(0)
  isActive       Boolean  @default(true)
  isFeatured     Boolean  @default(false)
  categoryId     String
  /// Seed marker: source = "pexels" rows are demo data and must be purged
  /// before go-live (SEC-27).
  source         String?
  externalId     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category     Category         @relation(fields: [categoryId], references: [id])
  variants     ProductVariant[]
  reviews      Review[]
  wishlistedBy WishlistItem[]

  @@unique([source, externalId])
  @@index([categoryId])
  @@index([createdAt])
  @@index([basePrice])
  @@index([isActive, isFeatured])
  @@index([gender])
  @@index([source])
}

/// Stock lives here, per size+color combination, never on Product (AD-5).
/// price overrides Product.basePrice when set.
model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  size      String
  colorName String
  colorHex  String
  sku       String   @unique
  price     Decimal? @db.Decimal(12, 2)
  stock     Int      @default(0)
  isActive  Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([productId, size, colorName])
  @@index([productId])
  @@index([stock])
}

// ---------------------------------------------------------------------------
// Cart (F3)
// ---------------------------------------------------------------------------

/// Exactly one cart per user and one per guest cookie. On login the guest cart
/// is merged into the user cart and deleted.
model Cart {
  id        String   @id @default(cuid())
  userId    String?  @unique
  guestId   String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([variantId])
}

// ---------------------------------------------------------------------------
// Shipping and addresses (F3)
// ---------------------------------------------------------------------------

model Address {
  id         String   @id @default(cuid())
  userId     String
  fullName   String
  phone      String?
  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String?
  country    String // ISO 3166-1 alpha-2
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// countries = ["*"] is the catch-all zone, matched only when no explicit zone
/// contains the destination country.
model ShippingZone {
  id        String   @id @default(cuid())
  name      String
  countries String[]
  position  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rates ShippingRate[]
}

model ShippingRate {
  id       String   @id @default(cuid())
  zoneId   String
  name     String
  price    Decimal  @db.Decimal(12, 2)
  freeOver Decimal? @db.Decimal(12, 2)
  minDays  Int      @default(3)
  maxDays  Int      @default(10)
  isActive Boolean  @default(true)

  zone ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([zoneId])
}

// ---------------------------------------------------------------------------
// Orders (F3)
// ---------------------------------------------------------------------------

/// Totals are recomputed server-side from the DB at checkout (SEC-4); client
/// amounts are never read. Address and item snapshots keep historical orders
/// immune to later catalog or address edits.
model Order {
  id              String               @id @default(cuid())
  orderNumber     String               @unique
  userId          String?
  email           String
  status          OrderStatus          @default(PENDING)
  paymentStatus   PaymentStatus        @default(PENDING)
  currency        String
  fxRate          Decimal?             @db.Decimal(18, 8)
  subtotal        Decimal              @db.Decimal(12, 2)
  shippingTotal   Decimal              @db.Decimal(12, 2)
  taxTotal        Decimal              @db.Decimal(12, 2)
  discountTotal   Decimal              @default(0) @db.Decimal(12, 2)
  grandTotal      Decimal              @db.Decimal(12, 2)
  shippingAddress Json
  billingAddress  Json?
  shippingMethod  String?
  provider        PaymentProviderKind?
  providerRef     String?
  /// One key per checkout attempt; this unique constraint is the last line of
  /// defence behind the Redis idempotency check (SEC-20).
  idempotencyKey  String               @unique
  placedAt        DateTime             @default(now())
  paidAt          DateTime?
  expiresAt       DateTime?
  cancelledAt     DateTime?
  refundedAt      DateTime?
  refundRef       String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  user  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([providerRef])
  @@index([expiresAt])
  @@index([placedAt])
}

model OrderItem {
  id               String  @id @default(cuid())
  orderId          String
  /// Nullable with SetNull: deleting a variant must never rewrite order history.
  variantId        String?
  productId        String?
  productTitle     String
  productSlug      String
  variantSize      String
  variantColorName String
  variantColorHex  String
  sku              String
  image            String?
  unitPrice        Decimal @db.Decimal(12, 2)
  quantity         Int
  lineTotal        Decimal @db.Decimal(12, 2)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([variantId])
}

// ---------------------------------------------------------------------------
// Reviews, wishlist, outbox (F6) — schema lands in F0 so F6 needs no migration
// ---------------------------------------------------------------------------

model Review {
  id     String  @id @default(cuid())
  productId String
  userId    String
  rating    Int
  title     String?
  body      String
  /// Computed server-side from paid/delivered orders, never client-claimed.
  verifiedPurchase Boolean      @default(false)
  status           ReviewStatus @default(PENDING)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId, status])
  @@index([userId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

/// Email outbox: rows are queued by the app and sent by a worker (F6), so a
/// provider outage delays mail instead of losing it.
model Notification {
  id            String             @id @default(cuid())
  userId        String?
  type          NotificationType
  status        NotificationStatus @default(QUEUED)
  to            String
  subject       String
  payload       Json               @default("{}")
  attempts      Int                @default(0)
  lastError     String?
  nextAttemptAt DateTime?
  sentAt        DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([userId])
}

/// Dedupe key for payment webhooks: a replayed event hits this unique
/// constraint and is skipped instead of decrementing stock twice.
model WebhookEvent {
  id          String              @id @default(cuid())
  provider    PaymentProviderKind
  eventId     String
  payload     Json
  receivedAt  DateTime            @default(now())
  processedAt DateTime?

  @@unique([provider, eventId])
}

/// Small key/value store for runtime-tunable settings (for example the flat tax
/// rate), overriding the env default when a row is present.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
