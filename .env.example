# Copy to .env and fill in. Everything here is SERVER-ONLY except the two
# NEXT_PUBLIC_ values at the bottom, which are non-sensitive by definition.
# Never give a secret a NEXT_PUBLIC_ prefix (SEC-12) — CI fails the build if you do.

# --- Database (Neon) -------------------------------------------------------
# Direct, non-pooled connection string. Migrations run against this.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"
# Optional: separate shadow database for `prisma migrate dev`.
# SHADOW_DATABASE_URL=""

# --- Shared state: Upstash Redis / Vercel KV (SEC-18) ----------------------
# Rate limits, checkout idempotency keys and locks live here. Required in
# production; when unset in development the limiter fails open and warns.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Auth (F1) -------------------------------------------------------------
# 32+ random bytes, e.g. `openssl rand -base64 48`. Rotating this invalidates
# every issued access token.
AUTH_SECRET=""

# --- Money -----------------------------------------------------------------
# Single base currency, no FX (see the plan). Easypaisa settles in PKR only.
BASE_CURRENCY="PKR"
# Flat tax rate as a decimal fraction, e.g. 0.18 for 18%. A Setting row with
# key "tax.rate" overrides this at runtime.
TAX_RATE="0"

# --- Seed data -------------------------------------------------------------
# Optional. When set, `npm run db:seed` pulls product imagery from the Pexels
# API; without it products get a local placeholder image instead.
PEXELS_API_KEY=""

# --- App -------------------------------------------------------------------
NODE_ENV="development"
APP_URL="http://localhost:3000"

# --- Public (non-sensitive, exposed to the browser) ------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Atlas & Co."

# --- Checkout & payments (F3) ---------------------------------------------
# How long an unpaid PENDING order stays payable. The expiry cron cancels it
# afterwards; no stock was ever held, so nothing is released (SEC-19).
ORDER_EXPIRY_MINUTES="30"

# Which PaymentProvider a checkout is routed to: easypaisa | stripe | fake.
# "fake" replays a locally signed postback so the whole PENDING -> verified-PAID
# lifecycle is testable without credentials. Boot REFUSES it in production.
PAYMENT_PROVIDER="fake"

# Bearer secret for /api/cron/expire-orders. Vercel Cron sends it as
# `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=""

# Easypaisa Hosted Checkout. hashKey is the 16-character AES key used both to
# sign the outbound request and to verify the IPN postback (AD-8, SEC-6).
EASYPAISA_STORE_ID=""
EASYPAISA_HASH_KEY=""
EASYPAISA_USERNAME=""
EASYPAISA_PASSWORD=""
EASYPAISA_ACCOUNT_NUM=""
# Sandbox hosts differ; override both when pointing at the sandbox.
# EASYPAISA_CHECKOUT_URL="https://easypay.easypaisa.com.pk/easypay/Index.jsf"
# EASYPAISA_INQUIRY_URL="https://easypay.easypaisa.com.pk/easypay-service/rest/v4/inquire-transaction"

# Stripe. Note PKR is not a presentment currency on most accounts and Stripe is
# unavailable to Pakistan-incorporated merchants — see CLAUDE.md "Decisions".
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Admin image upload (F4, SEC-14) --------------------------------------
# Where an admin-uploaded product image is written: local | blob.
# "local" writes under public/uploads and is a development affordance only —
# boot REFUSES it in production, because a serverless filesystem is read-only
# and per-instance. Production uses Vercel Blob.
IMAGE_STORE="local"
# Required when IMAGE_STORE="blob". `vercel env pull` supplies it once a Blob
# store is attached to the project.
BLOB_READ_WRITE_TOKEN=""
# Ceiling on a single uploaded image, in bytes. Checked against Content-Length
# and again against the bytes actually received.
UPLOAD_MAX_BYTES="5242880"

# --- Transactional email (F6) ---------------------------------------------
# Which driver the outbox worker sends through: log | resend.
# "log" prints each message and reports success, so the queue lifecycle works
# with no mail provider — boot REFUSES it in production, on the same principle
# as PAYMENT_PROVIDER="fake": a deployment that logs password resets instead of
# sending them looks healthy right up until a customer is locked out.
EMAIL_DRIVER="log"
# Required when EMAIL_DRIVER="resend". https://resend.com/api-keys
RESEND_API_KEY=""
# Envelope sender. Must be on a domain verified with Resend.
EMAIL_FROM="orders@example.com"

# --- AI shopping assistant (F5) -------------------------------------------
# Kill switch. "false" makes /api/assistant/chat answer 503 and removes the
# widget, without a code change.
AI_ASSISTANT_ENABLED="true"

# Gemini API key. Server-only — it is read through env.ts, which throws if it
# is ever reached from browser code (SEC-12). Get one at
# https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=""

# Model id, and the one line AD-4 exists for: swapping the model is config.
AI_MODEL="gemini-2.5-flash"

# Optional endpoint override — Vertex AI or a regional proxy. Unset means
# Google's public Generative Language endpoint.
# GOOGLE_AI_BASE_URL=""

# free | paid. The free Gemini tier may train on prompts, so it is a
# development and demo affordance only: boot REFUSES it in production
# (SEC-13), exactly as it refuses PAYMENT_PROVIDER="fake".
AI_TIER="free"

# Hard cap on tool-call iterations per turn. Each step is a billed model call.
AI_MAX_STEPS="6"
